              "query": "SELECT to_timestamp(_timestamp / 1000000) AS \"time\",  -- Convert microseconds to readable time\r\n       body AS \"error\"                                 -- The actual error message\r\nFROM \"default\"                                         -- Use the default log stream\r\nWHERE k8s_container_name = 'error-generator'           -- Only our generator\r\n  AND body LIKE '%ERROR%'                              -- Only ERROR logs\r\nORDER BY _timestamp DESC                               -- Newest errors first\r\nLIMIT 20                                               -- Only show the latest 20",
