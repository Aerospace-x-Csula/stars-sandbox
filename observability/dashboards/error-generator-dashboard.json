          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') as \"x_axis_1\",   -- Group logs into 1-minute buckets\r\n       count(_timestamp) as \"y_axis_1\"                    -- Count errors in each bucket\r\nFROM \"default\"                                            -- Use the default log stream\r\nWHERE k8s_container_name = 'error-generator'              -- Only error-generator logs\r\n  AND body LIKE '%ERROR%'                                 -- Only logs containing ERROR\r\nGROUP BY x_axis_1                                         -- Group the counts by time\r\nORDER BY x_axis_1 ASC                                     -- Oldest time to newest",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [
